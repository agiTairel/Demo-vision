# Copia este archivo como .streamlit/secrets.toml (en local) o pega su contenido
# en Streamlit Cloud > App > Settings > Secrets. Nunca lo subas a GitHub.

# Proveedor principal: "anthropic", "openai" o "simulado" (pruebas sin clave)
PROVEEDOR = "anthropic"

# Con las dos claves, si el principal falla se usa el otro automáticamente
ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."

# Modelos (opcional). Más baratos/rápidos: claude-haiku-5-5 o gpt-6-luna
ANTHROPIC_MODEL = "claude-sonnet-5-5"
OPENAI_MODEL = "gpt-6.1-sol"

# Límites para que nadie dispare la factura
LIMITE_POR_SESION = "12"
LIMITE_GLOBAL_HORA = "400"

# Llamada a la acción
EMAIL_CONTACTO = "info@taireldata.com"
WEB_CONTACTO = "https://taireldata.com"
# Si tenéis un formulario (Google Forms, Calendly, HubSpot...) para captar contactos:
FORMULARIO_LEADS = ""

# "1" muestra un panel de diagnóstico al final de la página
MOSTRAR_DIAGNOSTICO = "0"

# Contactos del formulario -> Google Sheets (ver google_sheets_leads.gs)
LEADS_WEBHOOK_URL = "https://script.google.com/macros/s/XXXX/exec"
LEADS_TOKEN = "la-misma-clave-que-en-el-script"
